# AI transcript correction (optional). When GEMINI_API_KEY is set, the pipeline
# runs a Gemini cleanup pass over the raw speech-to-text output. Without it,
# the "AI Polish" toggle silently falls back to the raw transcript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tuning (optional): segments per request, and parallel requests. Raise the
# batch size to cut round-trips; lower it / lower concurrency on a free-tier key.
GEMINI_BATCH_SIZE=120
GEMINI_CONCURRENCY=4

# Transcription via OpenAI (optional). When OPENAI_API_KEY is set, audio is
# transcribed with the OpenAI API instead of the local faster-whisper service
# — the local Python service then isn't needed at all. Without it, the local
# service is used. whisper-1 is recommended (it returns segment timestamps).
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# App URL (if hosted)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transcription Service URL
TRANSCRIPTION_SERVICE_URL=http://localhost:8000

# Google Drive integration (OAuth — each user saves to their own Drive).
# In Google Cloud Console create an OAuth 2.0 Client ID of type "Web
# application" and add <NEXT_PUBLIC_APP_URL>/api/auth/callback/google as an
# authorized redirect URI. Leave blank to disable the Drive feature.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
